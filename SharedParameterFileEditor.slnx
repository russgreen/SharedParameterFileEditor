<Solution>
  <Configurations>
    <Platform Name="x64" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path="Directory.Build.props" />
    <File Path="README.md" />
    <File Path="SyncfusionKey.txt" />
    <File Path="SyncfusionLicenseRegister.bat" />
  </Folder>
  <Project Path="build/_build.csproj" />
  <Project Path="SharedParameterFileEditor/SharedParameterFileEditor.csproj">
    <Platform Project="x64" />
  </Project>
  <Project Path="SharedParametersDefinitionFile/SharedParametersDefinitionFile.csproj">
    <Platform Project="x64" />
  </Project>
  <!-- Built by the Installer target in the Fallout build, not by the solution configurations. -->
  <Project Path="installer/SharedParameterFileEditor.Setup.wixproj">
    <Platform Solution="*|x64" Project="x64" />
    <Build Solution="*|*" Project="false" />
  </Project>
</Solution>
